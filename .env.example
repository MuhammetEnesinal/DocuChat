# docker-compose.yml bu dosyanın .env kopyasından okur.
# Kurulum: bu dosyayı .env adıyla kopyala ve gerçek değerleri doldur.
# .env ASLA commit edilmez (gitignore'da).

# PostgreSQL şifresi (compose hem db'yi hem api bağlantısını bununla kurar)
POSTGRES_PASSWORD=degistir-beni

# JWT imzalama anahtarı (uzun ve rastgele olmalı)
JWT_SECRET=degistir-beni-en-az-32-karakter-rastgele

# Mistral API anahtarları (ana model + yardımcı model)
MISTRAL_API_KEY=
MISTRAL_HELPER_API_KEY=

# SMTP uygulama şifresi (şifre sıfırlama e-postaları için)
EMAIL_PASSWORD=
