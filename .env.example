# docker-compose.yml bu dosyanın .env kopyasından okur.
# Kurulum: bu dosyayı .env adıyla kopyala ve gerçek değerleri doldur.
# .env ASLA commit edilmez (gitignore'da).

# PostgreSQL şifresi (compose hem db'yi hem api bağlantısını bununla kurar)
POSTGRES_PASSWORD=degistir-beni

# JWT imzalama anahtarı (uzun ve rastgele olmalı)
JWT_SECRET=degistir-beni-en-az-32-karakter-rastgele

# Mistral API anahtarları (ana model + yardımcı model)
MISTRAL_API_KEY=
MISTRAL_HELPER_API_KEY=

# SMTP gönderen e-posta + uygulama şifresi (şifre sıfırlama e-postaları için)
EMAIL_FROM=gonderen@example.com
EMAIL_PASSWORD=

# İlk admin (admin@docuchat.local) şifresi — YALNIZ boş veritabanında ilk kurulumda kullanılır.
# Güçlü ve rastgele belirleyin; ilk girişten sonra uygulamadan değiştirin.
SEED_ADMIN_PASSWORD=degistir-beni-guclu-bir-admin-sifresi

# MinIO (S3-uyumlu object storage) kök kimlik bilgileri. Aynı değerler hem minio kök kullanıcısı
# hem de api'nin S3 access/secret'ı olarak kullanılır. SECRET en az 8 karakter olmalı.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=degistir-beni-guclu-bir-sifre
