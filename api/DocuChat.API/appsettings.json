{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=DocuChatDB;Username=postgres;Password=***REMOVED***"
  },
  "Jwt": {
    "Secret": "***REMOVED***",
    "Issuer": "DocuChat",
    "Audience": "DocuChatUsers",
    "ExpiryHours": "24"
  },
  "Llm": {
    "Provider": "OpenAI",
    "ApiKey": "***REMOVED***",
    "Model": "mistral-large-latest",
    "BaseUrl": "https://api.mistral.ai",
    "ChatCompletionsPath": "/v1/chat/completions",
    "MaxTokens": "4096",
    "MaxImages": 0
  },
  "LlmHelper": {
    "ApiKey": "***REMOVED***",
    "Model": "mistral-small-latest",
    "BaseUrl": "https://api.mistral.ai",
    "ChatCompletionsPath": "/v1/chat/completions"
  },
  "Embedding": {
    "ApiKey": "",
    "Model": "bge-m3",
    "BaseUrl": "http://localhost:11434",
    "Dimensions": 1024,
    "TimeoutSeconds": 300
  },
 
  "Chunking": {
    "Mode": "Semantic",
    "MaxTokens": 1024,
    "MaxAtomicTokens": 1500,
    "MaxParallel": 2,
    "CommitBatchSize": 50,
    "AdaptiveEnabled": true,
    "AdaptiveMultiplier": 2.5,
    "AdaptiveMinTokens": 400,
    "AdaptiveMaxTokens": 1024,
    "BlockCoalescer": {
      "MinTokens": 80,
      "MaxMergedTokens": 400
    }
  },
  "ChunkContext": {
    "BatchTokenBudget": 18000
  },
  "DocumentProcessing": {
    "MaxConcurrent": 2,
    "QueueCapacity": 1000
  },
  "Storage": {
    "LocalPath": "uploads"
  },
  "LibreOffice": {
    "Path": "C:\\Program Files\\LibreOffice\\program\\soffice.exe"
  },
  "Mistral": {
    "ApiKey": "***REMOVED***",
    "BaseUrl": "https://api.mistral.ai",
    "Model": "mistral-ocr-latest",
    "TimeoutSeconds": "120"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/docuchat-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName" ]
  },
  
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000"
  ],
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "From": "***REMOVED***",
    "Password": "***REMOVED***"
  },
  "Cache": {
    "SimilarityThreshold": 0.90,
    "HighConfidenceThreshold": 0.97
  },
  "Chat": {
    "HistoryTokenBudget": 5000,
    "HistoryMaxMessages": 20,
    "FollowUpsEnabled": true
  },
  "VectorSearch": {
    "RerankCandidates": 12,
    "Bm25Enabled": true,
    "Bm25TsConfig": "turkish",
    "RrfK": 60,
    "NeighborExpansion": true
  },
  "Reranker": {
    "BaseUrl": "http://127.0.0.1:8085",
    "MinScore": 0.15,
    "TimeoutSeconds": 120,
    "Enabled": true
  },
  "Caption": {
    "Enabled": true,
    "Provider": "Mistral",
    "ApiKey": "***REMOVED***",
    "BaseUrl": "https://api.mistral.ai",
    "ChatCompletionsPath": "/v1/chat/completions",
    "Model": "pixtral-12b-2409",
    "MaxImageDimension": 1024,
    "SkipResizeBelow": 800,
    "MaxImagesPerDocument": 30,
    "MaxParallel": 3,
    "TimeoutSeconds": 60
  }
}